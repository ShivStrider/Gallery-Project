<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base activity theme. Compose draws everything; the platform theme just
         removes the action bar and lets the activity render edge-to-edge. -->
    <style name="Theme.FaceAlbum" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
